# Secrets — belt-and-braces; PhotoPicker has no runtime env vars today but
# scripts/experiments sometimes drop a .env for one-off testing. Do not leak.
.env
.env.*
!.env.example

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/
*.egg-info/
.ruff_cache/
.mypy_cache/
.DS_Store
.vscode/
.idea/

# Session ephemera (auto-improve tick state + fleet claims coordination)
.autoimprove/
.claims/
SESSION_GOAL.md

# Added 2026-08-19 (fleet-wide .gitignore audit): coverage shards and run logs
# were the only gaps left in an otherwise complete list.
.coverage.*
*.log
Thumbs.db
